"""
presentation/compositions/hero.py
────────────────────────────────────────────────────────────────────────────
Generic ElementSpec renderer + HERO composition handler.

Architecture
------------
Gemini = Creative Director  →  Python = Executor

This module provides two layers:

1. render_elements_from_spec(pptx_slide, slide, spec, builder, image_path)
   ── Generic renderer that converts any SlideDesignSpec.elements[] into
      PPTX objects using exact Gemini coordinates.  No archetype logic.
      Called by renderer.py for ALL archetypes when Gemini spec is present.

2. render_hero(pptx_slide, slide, directive, builder)
   ── HERO composition handler (IMPLEMENTED).
      Uses render_elements_from_spec when spec is available,
      falls back to theme-consistent hero layout otherwise.

Supported element types
-----------------------
    title · subtitle · body · image · shape · divider · card

ElementSpec → PPTX coordinate contract
---------------------------------------
    x      → Inches(el.x)
    y      → Inches(el.y)
    width  → Inches(el.width)
    height → Inches(el.height)

Python never overrides these values.

Public API
----------
    render_elements_from_spec(pptx_slide, slide, spec, builder,
                              image_path=None) -> bool
    render_hero(pptx_slide, slide, directive, builder) -> None
    register() -> None
"""

from __future__ import annotations

import logging
from pathlib import Path
from typing import Any

from pptx.util import Inches, Pt
from pptx.enum.text import PP_ALIGN

from ai.schemas import SlideData, SlideLayout
from presentation.styles import TOKENS

logger = logging.getLogger(__name__)

TK = TOKENS

# ── alignment string → PP_ALIGN mapping ──────────────────────────────────
_ALIGN_MAP: dict[str, Any] = {
    "left":   PP_ALIGN.LEFT,
    "center": PP_ALIGN.CENTER,
    "right":  PP_ALIGN.RIGHT,
}

# ── slide dimensions (inches) ─────────────────────────────────────────────
_SLIDE_W = 13.33
_SLIDE_H = 7.5


# ═══════════════════════════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════════════════════════

def _safe_color(value: str | None, fallback: str) -> str:
    if value and isinstance(value, str) and value.startswith("#") and len(value) >= 7:
        return value
    return fallback


def _safe_font(value: str | None, fallback: str) -> str:
    return value.strip() if value and value.strip() else fallback


def _safe_size(value: int | None, fallback: int) -> int:
    if value and isinstance(value, int) and value > 0:
        return value
    return fallback


def _safe_coords(
    x: float, y: float, w: float, h: float
) -> tuple[Any, Any, Any, Any] | None:
    """Return (Inches(x), Inches(y), Inches(w), Inches(h)) or None if invalid."""
    if w <= 0 or h <= 0:
        return None
    return Inches(x), Inches(y), Inches(w), Inches(h)


def _is_bold(font_weight: str | None) -> bool:
    return (font_weight or "").lower() == "bold"


def _alignment(alignment: str | None) -> Any:
    return _ALIGN_MAP.get((alignment or "").lower(), None)


def _find_elements(spec: Any, *types: str) -> list[Any]:
    """Return elements from spec.elements whose type is in *types*, sorted by z_index."""
    elements = getattr(spec, "elements", []) or []
    matched = [e for e in elements if getattr(e, "type", "") in types]
    matched.sort(key=lambda e: getattr(e, "z_index", 0))
    return matched


def _all_elements_sorted(spec: Any) -> list[Any]:
    """Return all elements sorted by z_index (painter's algorithm)."""
    elements = getattr(spec, "elements", []) or []
    return sorted(elements, key=lambda e: getattr(e, "z_index", 0))


def _text_for_element(el: Any, slide: SlideData) -> str:
    """
    Resolve display text for a given element.
    Checks el.text first (explicit override from Gemini), then slide fields.
    """
    # Explicit text on the element takes priority
    explicit = getattr(el, "text", None)
    if explicit:
        return str(explicit)

    el_type = getattr(el, "type", "")
    c = slide.content

    if el_type == "title":
        return slide.title or ""
    if el_type == "subtitle":
        return c.get("subtitle", "")
    if el_type == "body":
        return c.get("body", "") or c.get("text", "")
    if el_type == "card":
        # cards may carry a label; fall back to empty (shape-only card)
        return c.get("card_text", "") or c.get("card_label", "")
    return ""


# ═══════════════════════════════════════════════════════════════════════════
# Per-element renderers
# ═══════════════════════════════════════════════════════════════════════════

def _render_shape_element(pptx_slide: Any, el: Any, theme: Any) -> None:
    """Render a shape / divider / card-background using exact ElementSpec coords."""
    from presentation.builder import _add_rect
    coords = _safe_coords(el.x, el.y, el.width, el.height)
    if coords is None:
        return
    ix, iy, iw, ih = coords
    fill   = _safe_color(getattr(el, "fill_color", None), theme.primary)
    border = getattr(el, "border_color", None)
    _add_rect(pptx_slide, ix, iy, iw, ih, fill,
              border if (border and border.startswith("#")) else None)


def _render_text_element(
    pptx_slide: Any,
    text: str,
    el: Any,
    default_size: int,
    default_color: str,
    default_font: str,
) -> None:
    """Render a text element using exact ElementSpec coords + typography."""
    from presentation.builder import _add_text
    if not text:
        return
    coords = _safe_coords(el.x, el.y, el.width, el.height)
    if coords is None:
        return
    ix, iy, iw, ih = coords
    size  = _safe_size(getattr(el, "font_size", None), default_size)
    color = _safe_color(getattr(el, "font_color", None), default_color)
    font  = _safe_font(getattr(el, "font_family", None), default_font)
    bold  = _is_bold(getattr(el, "font_weight", None))
    align = _alignment(getattr(el, "alignment", None))
    _add_text(pptx_slide, text, ix, iy, iw, ih, size, color, font,
              bold=bold, align=align)


def _render_image_element(
    pptx_slide: Any,
    el: Any,
    image_path: str | None,
) -> None:
    """
    Render an image element using exact ElementSpec coords.

    Resolution order:
        1. el.asset_id → image_path dict (passed from renderer)
        2. image_path  → slide-level image (resolver already validated)
        3. No image    → skip silently (no crash)
    """
    coords = _safe_coords(el.x, el.y, el.width, el.height)
    if coords is None:
        return
    ix, iy, iw, ih = coords

    # Resolve path
    resolved: Path | None = None
    if image_path:
        candidate = Path(image_path)
        if candidate.exists():
            resolved = candidate

    if resolved is None:
        logger.debug(
            "render_image_element: no valid image path for asset_id=%r "
            "image_path=%r — skipping",
            getattr(el, "asset_id", None),
            image_path,
        )
        return

    try:
        pptx_slide.shapes.add_picture(str(resolved), ix, iy, iw, ih)
    except Exception as exc:
        logger.warning(
            "render_image_element: add_picture failed for %r: %s — skipping",
            str(resolved), exc,
        )


# ═══════════════════════════════════════════════════════════════════════════
# Generic renderer  ←  the core of this module
# ═══════════════════════════════════════════════════════════════════════════

def render_elements_from_spec(
    pptx_slide: Any,
    slide: SlideData,
    spec: Any,
    builder: Any,
    image_path: str | None = None,
) -> bool:
    """
    Render ALL elements in *spec* using Gemini's exact coordinates.

    This is the generic renderer called by renderer.py for every archetype
    when a valid Gemini SlideDesignSpec with elements is available.

    Returns True when at least one element was rendered, False otherwise
    (so the caller can decide whether to fall back).

    Pipeline
    --------
        SlideDesignSpec.elements[]
                ↓  (sorted by z_index — painter's algorithm)
        per-element type dispatch
                ↓
        PPTX shapes at exact Gemini coordinates

    Python makes NO layout decisions here.  Coordinates come entirely
    from Gemini.

    Parameters
    ----------
    pptx_slide  : python-pptx Slide (background already applied).
    slide       : SlideData for text content resolution.
    spec        : SlideDesignSpec (has .elements, .slide_index, …).
    builder     : PPTXBuilder (for theme + _add_* helpers).
    image_path  : Resolved image path for image elements (may be None).
    """
    elements = getattr(spec, "elements", None)
    if not elements:
        logger.debug(
            "render_elements_from_spec: slide_index=%d has no elements — "
            "skipping generic render",
            getattr(spec, "slide_index", "?"),
        )
        return False

    t = builder._theme
    rendered_count = 0

    # Render in z_index order (painter's algorithm: background first)
    for el in _all_elements_sorted(spec):
        el_type = getattr(el, "type", "")
        try:
            if el_type in ("shape", "divider"):
                _render_shape_element(pptx_slide, el, t)
                rendered_count += 1

            elif el_type == "card":
                # Cards: render background shape first, then text overlay if any
                _render_shape_element(pptx_slide, el, t)
                card_text = _text_for_element(el, slide)
                if card_text:
                    _render_text_element(
                        pptx_slide, card_text, el,
                        default_size=TK.body_font_normal,
                        default_color=t.text_light,
                        default_font=t.font_body,
                    )
                rendered_count += 1

            elif el_type == "image":
                _render_image_element(pptx_slide, el, image_path)
                rendered_count += 1

            elif el_type == "title":
                _render_text_element(
                    pptx_slide,
                    _text_for_element(el, slide),
                    el,
                    default_size=TK.heading_hero,
                    default_color=t.text_light,
                    default_font=t.font_heading,
                )
                rendered_count += 1

            elif el_type == "subtitle":
                _render_text_element(
                    pptx_slide,
                    _text_for_element(el, slide),
                    el,
                    default_size=TK.subtitle_font_size,
                    default_color=t.text_dark,
                    default_font=t.font_body,
                )
                rendered_count += 1

            elif el_type == "body":
                _render_text_element(
                    pptx_slide,
                    _text_for_element(el, slide),
                    el,
                    default_size=TK.body_font_normal,
                    default_color=t.text_dark,
                    default_font=t.font_body,
                )
                rendered_count += 1

            else:
                logger.debug(
                    "render_elements_from_spec: unknown element type=%r "
                    "slide_index=%d — skipping",
                    el_type, getattr(spec, "slide_index", "?"),
                )

        except Exception as exc:
            logger.warning(
                "render_elements_from_spec: element type=%r raised: %s "
                "— skipping element (slide_index=%d)",
                el_type, exc, getattr(spec, "slide_index", "?"),
            )

    logger.debug(
        "render_elements_from_spec: slide_index=%d elements_total=%d "
        "elements_rendered=%d",
        getattr(spec, "slide_index", "?"),
        len(elements),
        rendered_count,
    )
    return rendered_count > 0


# ═══════════════════════════════════════════════════════════════════════════
# HERO fallback (no Gemini spec)
# ═══════════════════════════════════════════════════════════════════════════

def _render_hero_fallback(
    pptx_slide: Any,
    slide: SlideData,
    builder: Any,
) -> None:
    """Theme-consistent HERO layout when no VisualDesignSpec is available."""
    from presentation.builder import _add_rect, _add_text
    t = builder._theme
    c = slide.content

    band_h = Inches(3.85)
    _add_rect(pptx_slide, Inches(0), Inches(0),
              Inches(_SLIDE_W), band_h, t.primary)
    _add_rect(pptx_slide, Inches(0), band_h - Inches(0.06),
              Inches(_SLIDE_W), Inches(0.06), t.accent)

    title_size = TK.heading_hero if len(slide.title) <= 80 else 32
    _add_text(pptx_slide, slide.title,
              Inches(0.75), Inches(0.75), Inches(11.83), Inches(2.8),
              title_size, t.text_light, t.font_heading, bold=True)

    subtitle = c.get("subtitle", "")
    if subtitle:
        sub_size = TK.subtitle_font_size if len(subtitle) <= 120 else 16
        _add_text(pptx_slide, subtitle,
                  Inches(0.75), Inches(4.1), Inches(11.0), Inches(1.5),
                  sub_size, t.text_dark, t.font_body)

    author = c.get("author", "")
    if author:
        _add_text(pptx_slide, author,
                  Inches(0.75), Inches(6.6), Inches(5.0), Inches(0.65),
                  TK.author_font_size, t.secondary, t.font_body, italic=True)


# ═══════════════════════════════════════════════════════════════════════════
# Public HERO handler
# ═══════════════════════════════════════════════════════════════════════════

def render_hero(
    pptx_slide: Any,
    slide: SlideData,
    directive: Any,
    builder: Any,
) -> None:
    """
    HERO composition handler (IMPLEMENTED).

    Uses render_elements_from_spec when builder._current_slide_spec is set,
    falls back to theme-consistent hero layout otherwise.
    """
    spec = getattr(builder, "_current_slide_spec", None)

    if spec is None:
        logger.debug(
            "render_hero: no SlideDesignSpec for slide index=%d — fallback",
            slide.index,
        )
        _render_hero_fallback(pptx_slide, slide, builder)
        return

    try:
        rendered = render_elements_from_spec(
            pptx_slide, slide, spec, builder,
            image_path=None,  # HERO slides don't use image_path
        )
        if not rendered:
            logger.debug(
                "render_hero: spec had no renderable elements for slide "
                "index=%d — fallback",
                slide.index,
            )
            _render_hero_fallback(pptx_slide, slide, builder)
    except Exception as exc:
        logger.error(
            "render_hero: spec-driven render raised for slide index=%d: %s "
            "— fallback",
            slide.index, exc, exc_info=True,
        )
        _render_hero_fallback(pptx_slide, slide, builder)


# ═══════════════════════════════════════════════════════════════════════════
# Registration
# ═══════════════════════════════════════════════════════════════════════════

def register() -> None:
    """Register render_hero as the IMPLEMENTED handler for LayoutArchetype.HERO."""
    from presentation.composition_selector import CompositionSelector
    from ai.slide_design_schema import LayoutArchetype

    CompositionSelector.register_handler(
        archetype=LayoutArchetype.HERO,
        handler=render_hero,
        layout=SlideLayout.TITLE,
        description="Generic ElementSpec renderer + HERO fallback",
    )
    logger.info("render_hero registered for LayoutArchetype.HERO")
