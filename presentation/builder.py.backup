import logging
from pathlib import Path

from pptx import Presentation
from pptx.util import Inches, Pt
from pptx.dml.color import RGBColor
from pptx.enum.text import PP_ALIGN, MSO_ANCHOR

from presentation.styles import Theme, TOKENS
from presentation.variants import VariantSelector, get_variants
from ai.schemas import SlideData, SlideLayout

logger = logging.getLogger(__name__)

# 16:9 widescreen dimensions
SLIDE_WIDTH  = Inches(13.33)
SLIDE_HEIGHT = Inches(7.5)

# Token alias for readability
TK = TOKENS


def _hex_to_rgb(hex_color: str) -> RGBColor:
    """Convert '#RRGGBB' to pptx RGBColor."""
    h = hex_color.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return RGBColor(r, g, b)


def _add_text(
    slide,
    text: str,
    x, y, w, h,
    size: int,
    color: str,
    font: str,
    bold: bool = False,
    italic: bool = False,
    word_wrap: bool = True,
    align=None,
    anchor=None,
) -> None:
    """Convenience: add a textbox with a single run."""
    box = slide.shapes.add_textbox(x, y, w, h)
    tf = box.text_frame
    tf.word_wrap = word_wrap
    if anchor is not None:
        tf.anchor = anchor
    p = tf.paragraphs[0]
    if align:
        p.alignment = align
    p.text = text
    if not p.runs:
        return
    r = p.runs[0]
    r.font.size   = Pt(size)
    r.font.bold   = bold
    r.font.italic = italic
    r.font.color.rgb = _hex_to_rgb(color)
    r.font.name   = font


def _add_rect(slide, x, y, w, h, fill_color: str, line_color: str | None = None):
    shape = slide.shapes.add_shape(1, x, y, w, h)
    shape.fill.solid()
    shape.fill.fore_color.rgb = _hex_to_rgb(fill_color)
    if line_color:
        shape.line.color.rgb = _hex_to_rgb(line_color)
    else:
        shape.line.fill.background()
    return shape


def _add_oval(slide, x, y, w, h, fill_color: str):
    shape = slide.shapes.add_shape(9, x, y, w, h)
    shape.fill.solid()
    shape.fill.fore_color.rgb = _hex_to_rgb(fill_color)
    shape.line.fill.background()
    return shape


def _fit_text_size(text: str, max_size: int, min_size: int, threshold_short: int = 80,
                   threshold_medium: int = 200) -> int:
    """
    Content-aware font size selection.
    Short text → larger; long text → smaller; never below min_size.
    """
    n = len(text)
    if n <= threshold_short:
        return max_size
    elif n <= threshold_medium:
        # Linear interpolation between max and mid
        mid_size = (max_size + min_size) // 2
        ratio = (n - threshold_short) / (threshold_medium - threshold_short)
        return max(min_size, int(max_size - ratio * (max_size - mid_size)))
    else:
        return min_size


class BuilderError(Exception):
    """Raised when PPTXBuilder is used incorrectly."""


class PPTXBuilder:
    def __init__(self, theme: Theme) -> None:
        self._theme = theme
        self._prs: Presentation | None = None
        self._selector = VariantSelector()
        self.create_presentation()

    # ------------------------------------------------------------------
    # Setup
    # ------------------------------------------------------------------

    def create_presentation(self) -> None:
        """Initialise (or reset) the internal Presentation object."""
        prs = Presentation()
        prs.slide_width  = SLIDE_WIDTH
        prs.slide_height = SLIDE_HEIGHT
        self._prs = prs
        self._selector.reset()
        logger.debug("Presentation initialised (theme=%s)", self._theme.name)

    # ------------------------------------------------------------------
    # Slide addition
    # ------------------------------------------------------------------

    def add_slide(self, slide: SlideData, image_path: str | None = None) -> None:
        if self._prs is None:
            raise BuilderError("Presentation not initialised. Call create_presentation() first.")

        blank_layout = self._prs.slide_layouts[6]
        pptx_slide   = self._prs.slides.add_slide(blank_layout)

        # Background — every layout
        bg   = pptx_slide.background
        fill = bg.fill
        fill.solid()
        fill.fore_color.rgb = _hex_to_rgb(self._theme.background)

        # Pick variant for this slide's layout
        variant = self._selector.pick(slide.layout)

        # Resolve image_path: accept str or Path, validate existence.
        # Only IMAGE_TEXT layout embeds pictures; any other layout ignores the path.
        resolved_image_path: Path | None = None
        if image_path is not None:
            candidate = Path(image_path)
            if candidate.is_file():
                resolved_image_path = candidate
            else:
                logger.warning(
                    "image_path %r does not exist — falling back to placeholder",
                    image_path,
                )

        if image_path is not None and slide.layout != SlideLayout.IMAGE_TEXT:
            logger.warning(
                "image_path provided for non-IMAGE_TEXT slide index=%d layout=%s — "
                "path is discarded (only IMAGE_TEXT embeds images)",
                slide.index,
                slide.layout.value,
            )

        dispatch = {
            SlideLayout.TITLE:       self._render_title,
            SlideLayout.TITLE_TEXT:  self._render_title_text,
            SlideLayout.IMAGE_TEXT:  self._render_image_text,
            SlideLayout.TWO_COLUMNS: self._render_two_columns,
            SlideLayout.COMPARISON:  self._render_comparison,
            SlideLayout.TIMELINE:    self._render_timeline,
            SlideLayout.STATISTICS:  self._render_statistics,
            SlideLayout.CHART:       self._render_chart,
            SlideLayout.QUOTE:       self._render_quote,
            SlideLayout.CONCLUSION:  self._render_conclusion,
        }
        renderer = dispatch.get(slide.layout, self._render_fallback)

        if slide.layout == SlideLayout.IMAGE_TEXT:
            renderer(pptx_slide, slide, variant, image_path=resolved_image_path)
        else:
            renderer(pptx_slide, slide, variant)

        logger.debug(
            "Added slide index=%d layout=%s variant=%s title=%r image_path=%r resolved=%s",
            slide.index,
            slide.layout.value,
            variant,
            slide.title,
            image_path,
            resolved_image_path is not None,
        )

    # ==================================================================
    # TITLE — 3 compositionally distinct variants
    # ==================================================================

    def _render_title(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t = self._theme
        c = slide.content
        subtitle = c.get("subtitle", "")
        author   = c.get("author", "")

        if variant == "hero_left":
            # Left-column accent stripe + left-aligned text on dark background
            # Compositional choice: strong left anchor, text breathes to the right
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, SLIDE_HEIGHT, t.primary)
            # Thick accent stripe — visual left anchor
            _add_rect(pptx_slide, Inches(0), Inches(0), Inches(TK.accent_stripe_w * 2.5),
                      SLIDE_HEIGHT, t.accent)
            # Title — large, breathing room on right
            title_size = _fit_text_size(slide.title, TK.heading_hero, 32)
            _add_text(pptx_slide, slide.title,
                      Inches(0.75), Inches(2.0), Inches(10.8), Inches(2.8),
                      title_size, t.text_light, t.font_heading, bold=True)
            # Thin rule between title and subtitle
            _add_rect(pptx_slide, Inches(0.75), Inches(4.9), Inches(5.0), Inches(0.04), t.accent)
            if subtitle:
                _add_text(pptx_slide, subtitle,
                          Inches(0.75), Inches(5.1), Inches(10.8), Inches(1.1),
                          TK.subtitle_font_size, t.accent, t.font_body)
            if author:
                _add_text(pptx_slide, author,
                          Inches(0.75), Inches(6.55), Inches(6.0), Inches(0.65),
                          TK.author_font_size, t.text_light, t.font_body, italic=True)

        elif variant == "hero_band":
            # Horizontal band across the middle — editorial, magazine-style
            # Compositional choice: full-width band splits slide into top / band / bottom
            band_y = Inches(2.5)
            band_h = Inches(2.8)
            # Subtle background tint at top
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, band_y, t.background)
            # Primary band
            _add_rect(pptx_slide, Inches(0), band_y, SLIDE_WIDTH, band_h, t.primary)
            # Accent top edge of band
            _add_rect(pptx_slide, Inches(0), band_y, SLIDE_WIDTH, Inches(0.07), t.accent)
            # Title inside band, centered
            title_size = _fit_text_size(slide.title, 40, 30)
            _add_text(pptx_slide, slide.title,
                      Inches(0.7), band_y + Inches(0.25), Inches(11.93), Inches(2.0),
                      title_size, t.text_light, t.font_heading, bold=True, align=PP_ALIGN.CENTER)
            # Subtitle above the band (reverse hierarchy — creates tension)
            if subtitle:
                _add_text(pptx_slide, subtitle,
                          Inches(0.7), Inches(1.35), Inches(11.93), Inches(0.9),
                          TK.subtitle_font_size - 2, t.secondary, t.font_body,
                          align=PP_ALIGN.CENTER)
            # Author bottom right — minimal
            if author:
                _add_text(pptx_slide, author,
                          Inches(8.0), Inches(5.7), Inches(5.0), Inches(0.6),
                          TK.author_font_size, t.secondary, t.font_body, italic=True)

        else:  # hero_center (default)
            # Dark header band top half; content in lower half
            # Compositional choice: classic split — dark/light, clear hierarchy
            band_h = Inches(3.85)
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, band_h, t.primary)
            # Accent bottom edge
            _add_rect(pptx_slide, Inches(0), band_h - Inches(0.06), SLIDE_WIDTH, Inches(0.06),
                      t.accent)
            title_size = _fit_text_size(slide.title, TK.heading_hero, 30)
            _add_text(pptx_slide, slide.title,
                      Inches(0.75), Inches(0.75), Inches(11.83), Inches(2.8),
                      title_size, t.text_light, t.font_heading, bold=True)
            if subtitle:
                sub_size = _fit_text_size(subtitle, TK.subtitle_font_size, 16)
                _add_text(pptx_slide, subtitle,
                          Inches(0.75), Inches(4.1), Inches(11.0), Inches(1.5),
                          sub_size, t.text_dark, t.font_body)
            if author:
                _add_text(pptx_slide, author,
                          Inches(0.75), Inches(6.6), Inches(5.0), Inches(0.65),
                          TK.author_font_size, t.secondary, t.font_body, italic=True)

    # ==================================================================
    # TITLE_TEXT — 3 variants
    # ==================================================================

    def _render_title_text(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t    = self._theme
        body = slide.content.get("body", "")

        if variant == "editorial":
            # Strong left accent column; title large; body justified text block
            # Compositional choice: magazine editorial — asymmetric accent + text
            _add_rect(pptx_slide, Inches(0), Inches(0), Inches(TK.accent_stripe_w),
                      SLIDE_HEIGHT, t.accent)
            title_size = _fit_text_size(slide.title, TK.heading_large, 26)
            _add_text(pptx_slide, slide.title,
                      Inches(0.42), Inches(0.28), Inches(12.5), Inches(1.5),
                      title_size, t.primary, t.font_heading, bold=True)
            # Thin rule — clear H1 / body separation
            _add_rect(pptx_slide, Inches(0.42), Inches(1.85), Inches(12.45), Inches(0.03),
                      t.secondary)
            body_size = _fit_text_size(body, TK.body_font_normal, TK.body_font_small,
                                       threshold_short=120, threshold_medium=400)
            _add_text(pptx_slide, body,
                      Inches(0.42), Inches(2.05), Inches(12.45), Inches(5.15),
                      body_size, t.text_dark, t.font_body)

        elif variant == "large_statement":
            # Full-width top accent; oversized title; body below
            # Compositional choice: statement slide — title dominates top quarter
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, Inches(0.1), t.accent)
            title_size = _fit_text_size(slide.title, 40, 28)
            _add_text(pptx_slide, slide.title,
                      Inches(0.55), Inches(0.3), Inches(12.23), Inches(2.1),
                      title_size, t.primary, t.font_heading, bold=True)
            # Rule with visual weight
            _add_rect(pptx_slide, Inches(0.55), Inches(2.45), Inches(3.5), Inches(0.06), t.accent)
            body_size = _fit_text_size(body, TK.body_font_normal, TK.body_font_small,
                                       threshold_short=120, threshold_medium=400)
            _add_text(pptx_slide, body,
                      Inches(0.55), Inches(2.72), Inches(12.23), Inches(4.5),
                      body_size, t.text_dark, t.font_body)

        else:  # clean (default)
            # Pure white, minimal decoration — maximum reading comfort
            # Compositional choice: content-first, no distraction
            title_size = _fit_text_size(slide.title, TK.heading_large, 24)
            _add_text(pptx_slide, slide.title,
                      Inches(0.6), Inches(0.3), Inches(12.13), Inches(1.2),
                      title_size, t.primary, t.font_heading, bold=True)
            _add_rect(pptx_slide, Inches(0.6), Inches(1.52), Inches(1.8), Inches(0.04), t.accent)
            body_size = _fit_text_size(body, TK.body_font_large, TK.body_font_small,
                                       threshold_short=100, threshold_medium=380)
            _add_text(pptx_slide, body,
                      Inches(0.6), Inches(1.78), Inches(12.13), Inches(5.45),
                      body_size, t.text_dark, t.font_body)

    # ==================================================================
    # IMAGE_TEXT — 3 variants
    # ==================================================================

    def _render_image_text(self, pptx_slide, slide: SlideData, variant: str,
                           image_path: Path | None = None) -> None:
        t    = self._theme
        body = slide.content.get("body", "")
        image_query = slide.image_query or slide.content.get("image_query", "") or ""

        if variant == "image_overlay":
            # Right half image placeholder; left half text; title spans full top
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, Inches(1.2), t.primary)
            _add_text(pptx_slide, slide.title,
                      Inches(0.45), Inches(0.15), Inches(12.43), Inches(0.95),
                      TK.title_font_size, t.text_light, t.font_heading, bold=True)
            # Image area
            img_x, img_y, img_w, img_h = Inches(6.8), Inches(1.35), Inches(6.15), Inches(5.95)
            if image_path is not None:
                pptx_slide.shapes.add_picture(str(image_path), img_x, img_y, img_w, img_h)
            else:
                _add_rect(pptx_slide, img_x, img_y, img_w, img_h, t.secondary, t.primary)
                _add_text(pptx_slide, "[ Image ]",
                          Inches(8.5), Inches(3.75), Inches(2.75), Inches(0.65),
                          14, t.text_light, t.font_body, bold=True, align=PP_ALIGN.CENTER)
            body_size = _fit_text_size(body, TK.body_font_normal, TK.body_font_small)
            _add_text(pptx_slide, body,
                      Inches(0.45), Inches(1.55), Inches(6.1), Inches(5.65),
                      body_size, t.text_dark, t.font_body)

        elif variant == "image_sidebar":
            # Narrow left sidebar image; title + body on right
            img_x, img_y, img_w, img_h = Inches(0), Inches(0), Inches(3.4), SLIDE_HEIGHT
            if image_path is not None:
                pptx_slide.shapes.add_picture(str(image_path), img_x, img_y, img_w, img_h)
            else:
                _add_rect(pptx_slide, img_x, img_y, img_w, img_h, t.secondary)
                _add_text(pptx_slide, "[ Image ]",
                          Inches(0.2), Inches(3.4), Inches(3.0), Inches(0.65),
                          13, t.text_light, t.font_body, bold=True, align=PP_ALIGN.CENTER)
            # Accent divider
            _add_rect(pptx_slide, Inches(3.4), Inches(0), Inches(0.05), SLIDE_HEIGHT, t.accent)
            _add_text(pptx_slide, slide.title,
                      Inches(3.7), Inches(0.3), Inches(9.28), Inches(1.15),
                      TK.title_font_size, t.primary, t.font_heading, bold=True)
            _add_rect(pptx_slide, Inches(3.7), Inches(1.52), Inches(9.28), Inches(0.04), t.accent)
            body_size = _fit_text_size(body, TK.body_font_normal, TK.body_font_small)
            _add_text(pptx_slide, body,
                      Inches(3.7), Inches(1.75), Inches(9.28), Inches(5.45),
                      body_size, t.text_dark, t.font_body)

        else:  # image_split (default)
            # Title top, image right, body left — balanced 55/45 split
            self._add_slide_title(pptx_slide, slide.title)
            text_w = Inches(6.9)
            img_x  = Inches(7.55)
            img_w  = Inches(5.33)
            cont_y = Inches(TK.content_start_y)
            cont_h = SLIDE_HEIGHT - cont_y - Inches(0.2)
            body_size = _fit_text_size(body, TK.body_font_normal, TK.body_font_small)
            _add_text(pptx_slide, body,
                      Inches(TK.margin_outer), cont_y, text_w, cont_h,
                      body_size, t.text_dark, t.font_body)
            if image_path is not None:
                pptx_slide.shapes.add_picture(str(image_path), img_x, cont_y, img_w, cont_h)
            else:
                img_rect = _add_rect(pptx_slide, img_x, cont_y, img_w, cont_h,
                                     t.secondary, t.primary)
                tf = img_rect.text_frame
                tf.word_wrap = True
                p = tf.paragraphs[0]
                p.alignment = PP_ALIGN.CENTER
                p.text = "[ Image ]"
                if p.runs:
                    r = p.runs[0]
                    r.font.size  = Pt(14)
                    r.font.bold  = True
                    r.font.color.rgb = _hex_to_rgb(t.text_light)
                    r.font.name  = t.font_body

        if image_query and image_path is None:
            logger.debug("image_text slide has image_query=%r (placeholder shown)", image_query)
        elif image_path is not None:
            logger.debug("image_text slide rendered with image_path=%r", image_path)

    # ==================================================================
    # TWO_COLUMNS — 3 compositionally distinct variants
    # ==================================================================

    def _render_two_columns(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t  = self._theme
        c  = slide.content
        lt = c.get("left_title", "")
        lb = c.get("left_body", "")
        rt = c.get("right_title", "")
        rb = c.get("right_body", "")

        self._add_slide_title(pptx_slide, slide.title)
        cont_y = Inches(TK.content_start_y)
        cont_h = SLIDE_HEIGHT - cont_y - Inches(0.18)

        if variant == "asymmetric_columns":
            # 40/60 split — left: summary, right: detail
            # Compositional choice: unequal weight mirrors information hierarchy
            left_w  = Inches(4.6)
            right_w = Inches(7.5)
            left_x  = Inches(TK.margin_outer)
            right_x = Inches(5.35)
            # Left: accent-primary header
            _add_rect(pptx_slide, left_x, cont_y, left_w, Inches(TK.card_header_h), t.primary)
            _add_text(pptx_slide, lt, left_x + Inches(TK.card_pad_x), cont_y + Inches(0.08),
                      left_w - Inches(TK.card_pad_x * 2), Inches(TK.card_header_h - 0.16),
                      TK.heading_small - 1, t.text_light, t.font_heading, bold=True)
            lb_size = _fit_text_size(lb, TK.body_font_normal, TK.body_font_small)
            _add_text(pptx_slide, lb,
                      left_x, cont_y + Inches(TK.card_header_h + TK.gap_section * 0.5),
                      left_w, cont_h - Inches(TK.card_header_h + TK.gap_section),
                      lb_size, t.text_dark, t.font_body)
            # Right: accent header
            _add_rect(pptx_slide, right_x, cont_y, right_w, Inches(TK.card_header_h), t.accent)
            _add_text(pptx_slide, rt, right_x + Inches(TK.card_pad_x), cont_y + Inches(0.08),
                      right_w - Inches(TK.card_pad_x * 2), Inches(TK.card_header_h - 0.16),
                      TK.heading_small - 1, t.text_light, t.font_heading, bold=True)
            rb_size = _fit_text_size(rb, TK.body_font_normal, TK.body_font_small)
            _add_text(pptx_slide, rb,
                      right_x, cont_y + Inches(TK.card_header_h + TK.gap_section * 0.5),
                      right_w, cont_h - Inches(TK.card_header_h + TK.gap_section),
                      rb_size, t.text_dark, t.font_body)

        elif variant == "text_emphasis":
            # Equal columns but left larger font — emphasis on primary content
            # Compositional choice: visual weight differentiates primary vs supporting
            col_w  = Inches(5.9)
            left_x = Inches(TK.margin_outer)
            right_x = Inches(7.05)
            for x, col_t, col_b, hdr_color, bsize in (
                (left_x,  lt, lb, t.primary,   TK.body_font_large),
                (right_x, rt, rb, t.secondary, TK.body_font_small),
            ):
                _add_rect(pptx_slide, x, cont_y, col_w, Inches(TK.card_header_h), hdr_color)
                _add_text(pptx_slide, col_t, x + Inches(TK.card_pad_x), cont_y + Inches(0.08),
                          col_w - Inches(TK.card_pad_x * 2), Inches(TK.card_header_h - 0.16),
                          TK.heading_small, t.text_light, t.font_heading, bold=True)
                body_size = _fit_text_size(col_b, bsize, TK.body_font_small)
                _add_text(pptx_slide, col_b,
                          x, cont_y + Inches(TK.card_header_h + TK.gap_section * 0.5),
                          col_w, cont_h - Inches(TK.card_header_h + TK.gap_section),
                          body_size, t.text_dark, t.font_body)

        else:  # equal_columns (default)
            # Equal 50/50 split with center divider line
            # Compositional choice: classic parallel structure
            col_w  = Inches(5.9)
            left_x = Inches(TK.margin_outer)
            right_x = Inches(7.05)
            # Vertical divider
            div_x = Inches(6.77)
            _add_rect(pptx_slide, div_x, cont_y, Inches(0.04), cont_h, t.secondary)
            for x, col_t, col_b in ((left_x, lt, lb), (right_x, rt, rb)):
                _add_rect(pptx_slide, x, cont_y, col_w, Inches(TK.card_header_h), t.primary)
                _add_text(pptx_slide, col_t, x + Inches(TK.card_pad_x), cont_y + Inches(0.08),
                          col_w - Inches(TK.card_pad_x * 2), Inches(TK.card_header_h - 0.16),
                          TK.heading_small, t.text_light, t.font_heading, bold=True)
                body_size = _fit_text_size(col_b, TK.body_font_normal, TK.body_font_small)
                _add_text(pptx_slide, col_b,
                          x, cont_y + Inches(TK.card_header_h + TK.gap_section * 0.5),
                          col_w, cont_h - Inches(TK.card_header_h + TK.gap_section),
                          body_size, t.text_dark, t.font_body)

    # ==================================================================
    # COMPARISON — 3 variants
    # ==================================================================

    def _render_comparison(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t  = self._theme
        c  = slide.content
        ll = c.get("left_label", "")
        rl = c.get("right_label", "")
        lp = c.get("left_points") or []
        rp = c.get("right_points") or []

        def _render_bullet_list(slide_obj, points, x, y, w, h, size, color, font):
            """Render a list of bullet points into a textbox."""
            box = slide_obj.shapes.add_textbox(x, y, w, h)
            tf  = box.text_frame
            tf.word_wrap = True
            for i, pt in enumerate(points if isinstance(points, list) else []):
                para = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
                para.text = f"• {pt}"
                if para.runs:
                    r = para.runs[0]
                    r.font.size  = Pt(size)
                    r.font.color.rgb = _hex_to_rgb(color)
                    r.font.name  = font

        self._add_slide_title(pptx_slide, slide.title)
        cont_y = Inches(TK.content_start_y)
        cont_h = SLIDE_HEIGHT - cont_y - Inches(0.18)

        if variant == "card_comparison":
            # Two full-height cards with coloured top stripe
            # Compositional choice: card contrast makes comparison immediately clear
            col_w  = Inches(5.9)
            left_x = Inches(TK.margin_outer)
            right_x = Inches(7.05)
            # Left card: primary fill, accent stripe
            _add_rect(pptx_slide, left_x, cont_y, col_w, cont_h, t.primary)
            _add_rect(pptx_slide, left_x, cont_y, col_w, Inches(0.55), t.accent)
            _add_text(pptx_slide, ll,
                      left_x + Inches(TK.card_pad_x), cont_y + Inches(0.08),
                      col_w - Inches(TK.card_pad_x * 2), Inches(0.4),
                      TK.heading_small, t.text_light, t.font_heading, bold=True)
            lp_size = _fit_text_size(" ".join(str(p) for p in lp), TK.body_font_normal,
                                     TK.body_font_small)
            _render_bullet_list(pptx_slide, lp,
                                left_x + Inches(TK.card_pad_x), cont_y + Inches(0.68),
                                col_w - Inches(TK.card_pad_x * 2),
                                cont_h - Inches(0.82), lp_size, t.text_light, t.font_body)
            # Right card: light background, primary stripe
            _add_rect(pptx_slide, right_x, cont_y, col_w, cont_h, t.background,
                      t.primary)
            _add_rect(pptx_slide, right_x, cont_y, col_w, Inches(0.55), t.primary)
            _add_text(pptx_slide, rl,
                      right_x + Inches(TK.card_pad_x), cont_y + Inches(0.08),
                      col_w - Inches(TK.card_pad_x * 2), Inches(0.4),
                      TK.heading_small, t.text_light, t.font_heading, bold=True)
            rp_size = _fit_text_size(" ".join(str(p) for p in rp), TK.body_font_normal,
                                     TK.body_font_small)
            _render_bullet_list(pptx_slide, rp,
                                right_x + Inches(TK.card_pad_x), cont_y + Inches(0.68),
                                col_w - Inches(TK.card_pad_x * 2),
                                cont_h - Inches(0.82), rp_size, t.text_dark, t.font_body)

        elif variant == "vertical_comparison":
            # Top / bottom stacked rows — better for flowing text comparisons
            # Compositional choice: vertical stacking suits sequential reading
            row_h  = (7.5 - TK.content_start_y - 0.4) / 2
            top_y  = cont_y
            bot_y  = cont_y + Inches(row_h) + Inches(TK.gap_card)
            col_w  = Inches(TK.content_width)
            col_x  = Inches(TK.margin_outer)
            # Top row
            _add_rect(pptx_slide, col_x, top_y, col_w, Inches(TK.card_header_h), t.primary)
            _add_text(pptx_slide, ll, col_x + Inches(TK.card_pad_x), top_y + Inches(0.08),
                      col_w - Inches(TK.card_pad_x * 2), Inches(TK.card_header_h - 0.16),
                      TK.heading_small, t.text_light, t.font_heading, bold=True)
            lp_size = _fit_text_size(" ".join(str(p) for p in lp), TK.body_font_normal,
                                     TK.body_font_small)
            _render_bullet_list(pptx_slide, lp,
                                col_x, top_y + Inches(TK.card_header_h + 0.12),
                                col_w, Inches(row_h - TK.card_header_h - 0.12 - TK.gap_card * 0.5),
                                lp_size, t.text_dark, t.font_body)
            # Bottom row
            _add_rect(pptx_slide, col_x, bot_y, col_w, Inches(TK.card_header_h), t.accent)
            _add_text(pptx_slide, rl, col_x + Inches(TK.card_pad_x), bot_y + Inches(0.08),
                      col_w - Inches(TK.card_pad_x * 2), Inches(TK.card_header_h - 0.16),
                      TK.heading_small, t.text_light, t.font_heading, bold=True)
            rp_size = _fit_text_size(" ".join(str(p) for p in rp), TK.body_font_normal,
                                     TK.body_font_small)
            _render_bullet_list(pptx_slide, rp,
                                col_x, bot_y + Inches(TK.card_header_h + 0.12),
                                col_w, Inches(row_h - TK.card_header_h - 0.22),
                                rp_size, t.text_dark, t.font_body)

        else:  # split_screen (default)
            # Two coloured panels, full height, clear visual split
            # Compositional choice: symmetrical colour contrast = equal weight
            col_w  = Inches(5.9)
            left_x = Inches(TK.margin_outer)
            right_x = Inches(7.05)
            for x, label, pts, bg in (
                (left_x,  ll, lp, t.primary),
                (right_x, rl, rp, t.accent),
            ):
                _add_rect(pptx_slide, x, cont_y, col_w, cont_h, bg)
                _add_text(pptx_slide, label,
                          x + Inches(TK.card_pad_x), cont_y + Inches(TK.card_pad_y),
                          col_w - Inches(TK.card_pad_x * 2), Inches(0.52),
                          TK.heading_small + 2, t.text_light, t.font_heading, bold=True)
                # Thin rule under label
                _add_rect(pptx_slide, x + Inches(TK.card_pad_x),
                          cont_y + Inches(TK.card_pad_y + 0.6),
                          col_w - Inches(TK.card_pad_x * 2), Inches(0.03), t.text_light)
                pts_size = _fit_text_size(" ".join(str(p) for p in pts),
                                         TK.body_font_normal, TK.body_font_small)
                _render_bullet_list(pptx_slide, pts,
                                    x + Inches(TK.card_pad_x),
                                    cont_y + Inches(TK.card_pad_y + 0.75),
                                    col_w - Inches(TK.card_pad_x * 2),
                                    cont_h - Inches(TK.card_pad_y + 0.85),
                                    pts_size, t.text_light, t.font_body)

    # ==================================================================
    # TIMELINE — 3 compositionally distinct variants
    # ==================================================================

    def _render_timeline(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t      = self._theme
        events = slide.content.get("events") or []
        if not isinstance(events, list):
            events = []

        self._add_slide_title(pptx_slide, slide.title)
        cont_y = Inches(TK.content_start_y)

        if variant == "horizontal":
            # Events on horizontal spine — dates below, descriptions above (alternating)
            # Compositional choice: timeline spine is dominant visual element
            max_ev = min(len(events), 5)
            if max_ev == 0:
                return
            spine_y = Inches(4.15)
            spine_x = Inches(TK.margin_outer)
            spine_w = Inches(TK.content_width)
            # Spine
            _add_rect(pptx_slide, spine_x, spine_y, spine_w, Inches(0.07), t.primary)
            slot_w = TK.content_width / max_ev

            for i, ev in enumerate(events[:max_ev]):
                if not isinstance(ev, dict):
                    continue
                year = str(ev.get("year", ev.get("date", "")))
                desc = str(ev.get("description", ev.get("title", "")))
                cx = TK.margin_outer + i * slot_w + slot_w / 2
                dot_x = Inches(cx - 0.2)
                # Dot on spine
                _add_oval(pptx_slide, dot_x, spine_y - Inches(0.17),
                          Inches(0.4), Inches(0.4), t.accent)
                # Connecting tick
                _add_rect(pptx_slide, dot_x + Inches(0.18), cont_y + Inches(0.1),
                          Inches(0.04), spine_y - cont_y - Inches(0.1), t.secondary)
                # Year label below spine
                _add_text(pptx_slide, year,
                          Inches(cx - 0.75), spine_y + Inches(0.22),
                          Inches(1.5), Inches(0.45),
                          12, t.primary, t.font_heading, bold=True, align=PP_ALIGN.CENTER)
                # Description above spine — sized by content
                desc_size = _fit_text_size(desc, 14, 11, threshold_short=40,
                                           threshold_medium=100)
                _add_text(pptx_slide, desc,
                          Inches(cx - 1.1), cont_y,
                          Inches(2.2), spine_y - cont_y - Inches(0.25),
                          desc_size, t.text_dark, t.font_body, align=PP_ALIGN.CENTER)

        elif variant == "milestone_cards":
            # Full-width milestone cards, left accent bar marks event type
            # Compositional choice: card stack uses vertical rhythm consistently
            max_ev = min(len(events), 4)
            if max_ev == 0:
                return
            avail_h = 7.5 - TK.content_start_y - 0.2
            card_h  = Inches((avail_h - TK.gap_card * (max_ev - 1)) / max_ev)
            col_w   = Inches(TK.content_width)
            col_x   = Inches(TK.margin_outer)
            accent_colors = [t.accent, t.primary, t.secondary, t.accent]

            for i, ev in enumerate(events[:max_ev]):
                if not isinstance(ev, dict):
                    continue
                year  = str(ev.get("year", ev.get("date", "")))
                desc  = str(ev.get("description", ev.get("title", "")))
                card_y = cont_y + i * (card_h + Inches(TK.gap_card))
                bar_c  = accent_colors[i % len(accent_colors)]
                # Card background
                _add_rect(pptx_slide, col_x, card_y, col_w, card_h, t.background, t.secondary)
                # Left accent bar
                _add_rect(pptx_slide, col_x, card_y, Inches(0.15), card_h, bar_c)
                # Year — bold, coloured
                _add_text(pptx_slide, year,
                          col_x + Inches(0.32), card_y + Inches(0.1),
                          Inches(1.8), card_h - Inches(0.2),
                          15, bar_c, t.font_heading, bold=True,
                          anchor=MSO_ANCHOR.MIDDLE)
                # Description
                desc_size = _fit_text_size(desc, TK.body_font_normal, 13,
                                           threshold_short=60, threshold_medium=180)
                _add_text(pptx_slide, desc,
                          col_x + Inches(2.3), card_y + Inches(0.1),
                          col_w - Inches(2.5), card_h - Inches(0.2),
                          desc_size, t.text_dark, t.font_body,
                          anchor=MSO_ANCHOR.MIDDLE)

        else:  # vertical (default)
            # Vertical spine on left; events right with alternating dot nodes
            # Compositional choice: classic vertical timeline, balanced left/right
            spine_x = Inches(2.6)
            spine_y = cont_y
            spine_h = SLIDE_HEIGHT - cont_y - Inches(0.2)
            _add_rect(pptx_slide, spine_x, spine_y, Inches(0.06), spine_h, t.primary)
            max_ev = min(len(events), 6)
            if max_ev == 0:
                return
            spine_h_in = (7.5 - TK.content_start_y - 0.2)
            slot_h = (spine_h_in - 0.1) / max_ev

            for i, ev in enumerate(events[:max_ev]):
                if not isinstance(ev, dict):
                    continue
                year = str(ev.get("year", ev.get("date", "")))
                desc = str(ev.get("description", ev.get("title", "")))
                ey   = cont_y + Inches(i * slot_h + slot_h * 0.5 - 0.18)
                # Dot
                _add_oval(pptx_slide, spine_x - Inches(0.17), ey,
                          Inches(0.38), Inches(0.38), t.accent)
                # Year — right-aligned before spine
                _add_text(pptx_slide, year,
                          Inches(TK.margin_outer), ey - Inches(0.05),
                          Inches(1.9), Inches(0.45),
                          13, t.primary, t.font_heading, bold=True, align=PP_ALIGN.RIGHT)
                # Description — right of spine
                desc_size = _fit_text_size(desc, TK.body_font_normal, 13,
                                           threshold_short=50, threshold_medium=150)
                _add_text(pptx_slide, desc,
                          spine_x + Inches(0.22), ey - Inches(0.05),
                          Inches(10.2), Inches(slot_h * 0.9),
                          desc_size, t.text_dark, t.font_body)

    # ==================================================================
    # STATISTICS — 3 variants
    # ==================================================================

    def _render_statistics(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t     = self._theme
        stats = slide.content.get("stats") or []
        if not isinstance(stats, list):
            stats = []

        self._add_slide_title(pptx_slide, slide.title)
        items = stats[:4]
        n     = len(items)
        if n == 0:
            return

        cont_y = Inches(TK.content_start_y)
        cont_h = SLIDE_HEIGHT - cont_y - Inches(0.2)

        if variant == "big_number":
            # First stat dominates as hero; rest shown as a secondary row
            # Compositional choice: one number owns the slide, context below
            first = items[0] if items else {}
            value = str(first.get("value", "—"))
            label = str(first.get("label", ""))
            desc  = str(first.get("description", ""))

            hero_h = Inches(3.5) if len(items) > 1 else cont_h
            _add_rect(pptx_slide, Inches(TK.margin_outer), cont_y,
                      Inches(TK.content_width), hero_h, t.primary)
            # Accent left stripe on hero card
            _add_rect(pptx_slide, Inches(TK.margin_outer), cont_y,
                      Inches(0.12), hero_h, t.accent)
            val_size = _fit_text_size(value, TK.metric_font_huge, 44, threshold_short=4,
                                      threshold_medium=8)
            _add_text(pptx_slide, value,
                      Inches(0.75), cont_y + Inches(0.25),
                      Inches(TK.content_width - 0.35), Inches(2.2),
                      val_size, t.text_light, t.font_heading, bold=True, align=PP_ALIGN.CENTER)
            _add_text(pptx_slide, label,
                      Inches(0.75), cont_y + Inches(2.45),
                      Inches(TK.content_width - 0.35), Inches(0.75),
                      TK.metric_label_size + 2, t.accent, t.font_body, align=PP_ALIGN.CENTER)
            if desc:
                _add_text(pptx_slide, desc,
                          Inches(0.75), cont_y + Inches(3.2),
                          Inches(TK.content_width - 0.35), Inches(0.45),
                          TK.caption_font_size + 1, t.text_light, t.font_body,
                          align=PP_ALIGN.CENTER)

            # Secondary row
            rest = items[1:]
            r_n  = len(rest)
            if r_n > 0:
                row_y   = cont_y + hero_h + Inches(TK.gap_card)
                card_w  = Inches((TK.content_width - TK.gap_card * (r_n - 1)) / r_n)
                gap     = Inches(TK.gap_card)
                for j, stat in enumerate(rest):
                    if not isinstance(stat, dict):
                        continue
                    v  = str(stat.get("value", "—"))
                    lb = str(stat.get("label", ""))
                    rx = Inches(TK.margin_outer) + j * (card_w + gap)
                    _add_rect(pptx_slide, rx, row_y, card_w,
                              cont_h - hero_h - Inches(TK.gap_card), t.secondary)
                    _add_text(pptx_slide, v, rx + Inches(0.12), row_y + Inches(0.1),
                              card_w - Inches(0.24), Inches(0.7),
                              TK.metric_font_medium - 4, t.text_light, t.font_heading, bold=True)
                    _add_text(pptx_slide, lb, rx + Inches(0.12),
                              row_y + Inches(0.85),
                              card_w - Inches(0.24), Inches(0.55),
                              TK.caption_font_size + 1, t.text_light, t.font_body)

        elif variant == "horizontal_metrics":
            # Rows: coloured left bar + big value + label — structured list feel
            # Compositional choice: horizontal rows good for 3-4 comparable metrics
            cont_h_in = 7.5 - TK.content_start_y - 0.2
            row_h   = (cont_h_in - TK.gap_card * (n - 1)) / n
            bar_colors = [t.primary, t.accent, t.secondary, t.primary]

            for i, stat in enumerate(items):
                if not isinstance(stat, dict):
                    continue
                value = str(stat.get("value", "—"))
                label = str(stat.get("label", ""))
                desc  = str(stat.get("description", ""))
                ry    = cont_y + Inches(i * (row_h + TK.gap_card))
                bc    = bar_colors[i % len(bar_colors)]
                row_h_in = Inches(row_h)
                col_x = Inches(TK.margin_outer)
                col_w = Inches(TK.content_width)
                # Row background (subtle)
                _add_rect(pptx_slide, col_x, ry, col_w, row_h_in, t.background, t.secondary)
                # Accent left bar
                _add_rect(pptx_slide, col_x, ry, Inches(0.14), row_h_in, bc)
                # Value
                val_size = _fit_text_size(value, TK.metric_font_medium, 26,
                                          threshold_short=4, threshold_medium=8)
                _add_text(pptx_slide, value,
                          col_x + Inches(0.28), ry + Inches(0.1),
                          Inches(2.8), row_h_in - Inches(0.2),
                          val_size, bc, t.font_heading, bold=True,
                          anchor=MSO_ANCHOR.MIDDLE)
                # Label + description
                _add_text(pptx_slide, label,
                          col_x + Inches(3.2), ry + Inches(0.12),
                          Inches(TK.content_width - 3.4), Inches(row_h * 0.55),
                          TK.body_font_normal - 2, t.text_dark, t.font_body, bold=True)
                if desc:
                    _add_text(pptx_slide, desc,
                              col_x + Inches(3.2), ry + Inches(row_h * 0.55),
                              Inches(TK.content_width - 3.4), Inches(row_h * 0.45),
                              TK.caption_font_size + 1, t.secondary, t.font_body)

        else:  # three_cards (default)
            # Equal metric cards — grid of numbers
            # Compositional choice: uniform grid good for parallel comparison
            gap     = Inches(TK.gap_card)
            card_w  = Inches((TK.content_width - TK.gap_card * (n - 1)) / n)
            card_h  = cont_h

            for i, stat in enumerate(items):
                if not isinstance(stat, dict):
                    continue
                value = str(stat.get("value", "—"))
                label = str(stat.get("label", ""))
                desc  = str(stat.get("description", ""))
                cx    = Inches(TK.margin_outer) + i * (card_w + gap)
                _add_rect(pptx_slide, cx, cont_y, card_w, card_h, t.primary)
                # Accent top stripe on cards
                _add_rect(pptx_slide, cx, cont_y, card_w, Inches(0.1), t.accent)
                val_size = _fit_text_size(value, TK.metric_font_large, 32,
                                          threshold_short=4, threshold_medium=8)
                _add_text(pptx_slide, value,
                          cx + Inches(TK.card_pad_x), cont_y + Inches(0.35),
                          card_w - Inches(TK.card_pad_x * 2), Inches(2.0),
                          val_size, t.text_light, t.font_heading, bold=True,
                          align=PP_ALIGN.CENTER)
                _add_text(pptx_slide, label,
                          cx + Inches(TK.card_pad_x), cont_y + Inches(2.5),
                          card_w - Inches(TK.card_pad_x * 2), Inches(1.0),
                          TK.metric_label_size, t.accent, t.font_body,
                          align=PP_ALIGN.CENTER)
                if desc:
                    _add_text(pptx_slide, desc,
                              cx + Inches(TK.card_pad_x), cont_y + Inches(3.6),
                              card_w - Inches(TK.card_pad_x * 2),
                              card_h - Inches(3.8),
                              TK.caption_font_size + 1, t.text_light, t.font_body,
                              align=PP_ALIGN.CENTER)

    # ==================================================================
    # CHART — 3 variants
    # ==================================================================

    def _render_chart(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t          = self._theme
        c          = slide.content
        chart_type = c.get("chart_type", "Chart")
        description= c.get("description", "")
        data_hint  = c.get("data_hint", "")

        self._add_slide_title(pptx_slide, slide.title)
        cont_y = Inches(TK.content_start_y)
        cont_h = SLIDE_HEIGHT - cont_y - Inches(0.18)

        if variant == "chart_with_insight":
            # Chart placeholder left 65%, insight panel right 30%
            chart_w = Inches(TK.content_width * 0.67)
            panel_w = Inches(TK.content_width * 0.3)
            panel_x = Inches(TK.margin_outer) + chart_w + Inches(TK.gap_section)
            _add_rect(pptx_slide, Inches(TK.margin_outer), cont_y, chart_w, cont_h,
                      t.secondary, t.primary)
            _add_text(pptx_slide, f"[ {chart_type.upper()} ]",
                      Inches(TK.margin_outer + 0.2), cont_y + Inches(0.25),
                      chart_w - Inches(0.4), Inches(0.55),
                      12, t.text_light, t.font_heading, bold=True)
            if data_hint:
                _add_text(pptx_slide, data_hint,
                          Inches(TK.margin_outer + 0.2), cont_y + Inches(0.95),
                          chart_w - Inches(0.4), cont_h - Inches(1.1),
                          13, t.text_light, t.font_body, italic=True)
            # Insight panel
            _add_rect(pptx_slide, panel_x, cont_y, panel_w, cont_h, t.primary)
            _add_rect(pptx_slide, panel_x, cont_y, panel_w, Inches(0.08), t.accent)
            _add_text(pptx_slide, "Key Insight",
                      panel_x + Inches(0.18), cont_y + Inches(0.2),
                      panel_w - Inches(0.36), Inches(0.5),
                      14, t.accent, t.font_heading, bold=True)
            if description:
                desc_size = _fit_text_size(description, TK.body_font_normal, TK.body_font_small)
                _add_text(pptx_slide, description,
                          panel_x + Inches(0.18), cont_y + Inches(0.85),
                          panel_w - Inches(0.36), cont_h - Inches(1.0),
                          desc_size, t.text_light, t.font_body)

        elif variant == "chart_with_annotation":
            # Full-width chart with annotation strip below
            chart_h = cont_h - Inches(1.35)
            _add_rect(pptx_slide, Inches(TK.margin_outer), cont_y,
                      Inches(TK.content_width), chart_h, t.secondary, t.primary)
            _add_text(pptx_slide, f"[ {chart_type.upper()} ]",
                      Inches(TK.margin_outer + 0.2), cont_y + Inches(0.25),
                      Inches(TK.content_width - 0.4), Inches(0.55),
                      12, t.text_light, t.font_heading, bold=True)
            if data_hint:
                _add_text(pptx_slide, data_hint,
                          Inches(TK.margin_outer + 0.2), cont_y + Inches(0.95),
                          Inches(TK.content_width - 0.4), chart_h - Inches(1.1),
                          13, t.text_light, t.font_body, italic=True)
            # Annotation strip
            annot_y = cont_y + chart_h + Inches(TK.gap_section * 0.5)
            _add_rect(pptx_slide, Inches(TK.margin_outer), annot_y,
                      Inches(0.08), Inches(1.0), t.accent)
            if description:
                desc_size = _fit_text_size(description, TK.body_font_normal, TK.body_font_small)
                _add_text(pptx_slide, description,
                          Inches(TK.margin_outer + 0.22), annot_y,
                          Inches(TK.content_width - 0.3), Inches(1.1),
                          desc_size, t.text_dark, t.font_body)

        else:  # chart_focus (default)
            # Large chart placeholder, label + description inside
            _add_rect(pptx_slide, Inches(TK.margin_outer), cont_y,
                      Inches(TK.content_width), cont_h, t.secondary, t.primary)
            _add_text(pptx_slide, f"[ {chart_type.upper()} ]",
                      Inches(TK.margin_outer + 0.2), cont_y + Inches(0.25),
                      Inches(5.0), Inches(0.55),
                      12, t.text_light, t.font_heading, bold=True)
            if description:
                desc_size = _fit_text_size(description, TK.body_font_normal, TK.body_font_small)
                _add_text(pptx_slide, description,
                          Inches(TK.margin_outer + 0.2), cont_y + Inches(0.95),
                          Inches(TK.content_width - 0.4), Inches(2.2),
                          desc_size, t.text_light, t.font_body)
            if data_hint:
                _add_text(pptx_slide, data_hint,
                          Inches(TK.margin_outer + 0.2), cont_y + cont_h - Inches(1.2),
                          Inches(TK.content_width - 0.4), Inches(1.0),
                          TK.caption_font_size + 1, t.text_light, t.font_body, italic=True)

    # ==================================================================
    # QUOTE — 3 compositionally distinct variants
    # ==================================================================

    def _render_quote(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t      = self._theme
        c      = slide.content
        quote  = c.get("quote", "")
        author = c.get("author", "")
        source = c.get("source", "") or ""
        attribution = f"— {author}, {source}" if source else (f"— {author}" if author else "")

        if variant == "side_quote":
            # Strong left panel with giant quotation mark; quote text on right
            # Compositional choice: visual weight on left anchors the quote
            panel_w = Inches(2.8)
            _add_rect(pptx_slide, Inches(0), Inches(0), panel_w, SLIDE_HEIGHT, t.primary)
            # Large decorative quotation mark
            _add_text(pptx_slide, "\u201c",
                      Inches(0.1), Inches(1.0), panel_w - Inches(0.2), Inches(3.5),
                      108, t.accent, t.font_heading, bold=True, align=PP_ALIGN.CENTER)
            # Quote text on right side, vertically centered
            quote_size = _fit_text_size(quote, 32, 20, threshold_short=80, threshold_medium=250)
            _add_text(pptx_slide, quote,
                      panel_w + Inches(0.45), Inches(1.1),
                      Inches(13.33) - panel_w - Inches(0.75), Inches(4.8),
                      quote_size, t.text_dark, t.font_heading, italic=True)
            if attribution:
                # Attribution right-aligned, bottom
                _add_rect(pptx_slide, panel_w + Inches(0.45), Inches(6.25),
                          Inches(1.5), Inches(0.045), t.accent)
                _add_text(pptx_slide, attribution,
                          panel_w + Inches(0.45), Inches(6.42),
                          Inches(9.9), Inches(0.7),
                          TK.body_font_small, t.primary, t.font_body, bold=True)

        elif variant == "large_typography":
            # Minimal decoration, huge type — quote is the design
            # Compositional choice: typography IS the layout; whitespace is intentional
            _add_rect(pptx_slide, Inches(0), Inches(0), Inches(0.1), SLIDE_HEIGHT, t.accent)
            _add_rect(pptx_slide, SLIDE_WIDTH - Inches(0.1), Inches(0),
                      Inches(0.1), SLIDE_HEIGHT, t.accent)
            quote_size = _fit_text_size(quote, 38, 22, threshold_short=60, threshold_medium=220)
            _add_text(pptx_slide, f"\u201c{quote}\u201d",
                      Inches(0.55), Inches(1.0), Inches(12.23), Inches(5.3),
                      quote_size, t.primary, t.font_heading, italic=True)
            if attribution:
                _add_text(pptx_slide, attribution,
                          Inches(0.55), Inches(6.5), Inches(12.23), Inches(0.75),
                          TK.body_font_small + 1, t.secondary, t.font_body, bold=True)

        else:  # centered_quote (default)
            # Classic centered quote, large opening mark, attribution bottom
            # Compositional choice: centered = balanced, universal, dignified
            _add_text(pptx_slide, "\u201c",
                      Inches(0.35), Inches(0.1), Inches(2.2), Inches(1.8),
                      120, t.accent, t.font_heading, bold=True)
            quote_size = _fit_text_size(quote, 30, 18, threshold_short=80, threshold_medium=260)
            _add_text(pptx_slide, quote,
                      Inches(0.85), Inches(1.35), Inches(11.63), Inches(4.5),
                      quote_size, t.text_dark, t.font_heading, italic=True)
            # Rule before attribution
            if attribution:
                _add_rect(pptx_slide, Inches(0.85), Inches(6.05), Inches(2.5), Inches(0.04),
                          t.accent)
                _add_text(pptx_slide, attribution,
                          Inches(0.85), Inches(6.22), Inches(11.63), Inches(0.75),
                          TK.body_font_small + 1, t.primary, t.font_body, bold=True)

    # ==================================================================
    # CONCLUSION — 3 variants
    # ==================================================================

    def _render_conclusion(self, pptx_slide, slide: SlideData, variant: str) -> None:
        t       = self._theme
        c       = slide.content
        summary = c.get("summary", "")
        cta     = c.get("call_to_action", "") or ""

        if variant == "summary_cards":
            # Header band + 2-3 takeaway cards
            # Compositional choice: summary broken into scannable cards
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, Inches(1.05), t.primary)
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, Inches(0.08), t.accent)
            _add_text(pptx_slide, slide.title,
                      Inches(0.5), Inches(0.12), Inches(12.33), Inches(0.83),
                      TK.title_font_size - 2, t.text_light, t.font_heading, bold=True)
            lines = [l.strip() for l in summary.split("\n") if l.strip()] or [summary]
            n = min(len(lines), 3)
            if n == 0:
                return
            gap    = Inches(TK.gap_card)
            card_w = Inches((TK.content_width - TK.gap_card * (n - 1)) / n)
            card_y = Inches(1.22)
            card_h = SLIDE_HEIGHT - card_y - (Inches(1.0) if cta else Inches(0.2))
            colors = [t.primary, t.accent, t.secondary]
            for i, line in enumerate(lines[:n]):
                cx = Inches(TK.margin_outer) + i * (card_w + gap)
                _add_rect(pptx_slide, cx, card_y, card_w, card_h, colors[i % len(colors)])
                # Accent top stripe
                _add_rect(pptx_slide, cx, card_y, card_w, Inches(0.08),
                          t.accent if colors[i % len(colors)] != t.accent else t.background)
                body_size = _fit_text_size(line, TK.body_font_normal, TK.body_font_small)
                _add_text(pptx_slide, line,
                          cx + Inches(TK.card_pad_x), card_y + Inches(0.3),
                          card_w - Inches(TK.card_pad_x * 2), card_h - Inches(0.5),
                          body_size, t.text_light, t.font_body)
            if cta:
                _add_text(pptx_slide, cta,
                          Inches(TK.margin_outer), SLIDE_HEIGHT - Inches(0.85),
                          Inches(TK.content_width), Inches(0.7),
                          TK.body_font_small + 2, t.accent, t.font_body, bold=True)

        elif variant == "minimal_final":
            # Centered, spacious, one large statement — final impression
            # Compositional choice: ending with silence — let the content breathe
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, Inches(0.12), t.accent)
            _add_rect(pptx_slide, Inches(0), SLIDE_HEIGHT - Inches(0.12),
                      SLIDE_WIDTH, Inches(0.12), t.accent)
            title_size = _fit_text_size(slide.title, TK.heading_large, 26)
            _add_text(pptx_slide, slide.title,
                      Inches(0.8), Inches(0.42), Inches(11.73), Inches(1.1),
                      title_size, t.primary, t.font_heading, bold=True, align=PP_ALIGN.CENTER)
            sum_size = _fit_text_size(summary, TK.body_font_large, TK.body_font_small,
                                      threshold_short=80, threshold_medium=280)
            _add_text(pptx_slide, summary,
                      Inches(1.3), Inches(1.75), Inches(10.73), Inches(4.35),
                      sum_size, t.text_dark, t.font_body, align=PP_ALIGN.CENTER)
            if cta:
                _add_rect(pptx_slide, Inches(3.8), Inches(6.3), Inches(5.73), Inches(0.88), t.accent)
                _add_text(pptx_slide, cta,
                          Inches(3.8), Inches(6.32), Inches(5.73), Inches(0.85),
                          TK.body_font_small + 2, t.text_light, t.font_body, bold=True,
                          align=PP_ALIGN.CENTER, anchor=MSO_ANCHOR.MIDDLE)

        else:  # statement (default)
            # Dark header + large summary text — strong closing statement
            # Compositional choice: mirrors TITLE in weight — bookends the deck
            _add_rect(pptx_slide, Inches(0), Inches(0), SLIDE_WIDTH, Inches(1.05), t.primary)
            _add_text(pptx_slide, slide.title,
                      Inches(0.5), Inches(0.12), Inches(12.33), Inches(0.83),
                      TK.title_font_size - 2, t.text_light, t.font_heading, bold=True)
            # Accent left bar beside summary
            _add_rect(pptx_slide, Inches(TK.margin_outer), Inches(1.3),
                      Inches(0.1), Inches(5.85) - (Inches(1.05) if cta else Inches(0)),
                      t.accent)
            sum_size = _fit_text_size(summary, TK.body_font_large, TK.body_font_small,
                                      threshold_short=80, threshold_medium=300)
            cta_h = Inches(1.05) if cta else Inches(0)
            _add_text(pptx_slide, summary,
                      Inches(0.75), Inches(1.42), Inches(12.0),
                      SLIDE_HEIGHT - Inches(1.42) - cta_h - Inches(0.18),
                      sum_size, t.text_dark, t.font_body)
            if cta:
                _add_rect(pptx_slide, Inches(0), SLIDE_HEIGHT - Inches(1.1),
                          SLIDE_WIDTH, Inches(1.1), t.accent)
                _add_text(pptx_slide, cta,
                          Inches(0.6), SLIDE_HEIGHT - Inches(1.0),
                          Inches(12.13), Inches(0.88),
                          TK.body_font_small + 2, t.text_light, t.font_body, bold=True,
                          anchor=MSO_ANCHOR.MIDDLE)

    # ------------------------------------------------------------------
    # Shared helpers
    # ------------------------------------------------------------------

    def _add_slide_title(self, pptx_slide, title: str) -> None:
        """Standard top-area title used by most content layouts."""
        title_size = _fit_text_size(title, TK.title_font_size, 22,
                                    threshold_short=40, threshold_medium=100)
        _add_text(pptx_slide, title,
                  Inches(TK.margin_outer), Inches(0.2),
                  Inches(TK.content_width), Inches(TK.title_height),
                  title_size, self._theme.primary, self._theme.font_heading, bold=True)
        _add_rect(pptx_slide,
                  Inches(TK.margin_outer),
                  Inches(0.2 + TK.title_height + TK.gap_title_rule),
                  Inches(TK.content_width),
                  Inches(TK.title_rule_height),
                  self._theme.accent)

    def _render_fallback(self, pptx_slide, slide: SlideData, variant: str) -> None:
        """Generic fallback — title only."""
        _add_text(pptx_slide, slide.title,
                  Inches(TK.margin_outer), Inches(0.3), Inches(TK.content_width), Inches(1.0),
                  TK.title_font_size, self._theme.text_dark, self._theme.font_heading, bold=True)

    # ------------------------------------------------------------------
    # Save
    # ------------------------------------------------------------------

    def save(self, path: str) -> str:
        if self._prs is None:
            raise BuilderError("Nothing to save — presentation not initialised.")
        output = Path(path)
        output.parent.mkdir(parents=True, exist_ok=True)
        self._prs.save(str(output))
        logger.info("Presentation saved to %s", output)
        return str(output)
